SmalltalkCISpec {
	#loading : [
		SCIMetacelloLoadSpec {
			#baseline : 'Iris',
      #directory : 'src',
			#registerInIceberg : true,
			#platforms : [ #pharo ]
		}
	],
	#testing : {
    #exclude : {
      #packages : [ 'Iris-TestSupport' ]
    },
		#coverage : {
			#packages : [ 'Iris' ],
			#format : #lcov
		}
	}
}